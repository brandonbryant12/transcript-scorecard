# Read by the API only; keys never reach the browser. An empty value means "not configured".
# The API starts with any subset of keys and uses the first configured provider, in the
# order Gemini, OpenAI, JEV, when a request does not name one.

# Gemini Decisions (gemini-decision-1); also enables the voice practice call (Gemini Live).
GEMINI_API_KEY=
# OpenAI Decisions (gpt-6-luna).
OPENAI_API_KEY=
# TypeSafe JEV (System One).
JEV_API_KEY=

# Port the API listens on (127.0.0.1 only).
PORT=3001
# SQLite file, relative to apps/api. ":memory:" gives a throwaway database.
SCORECARD_DB_PATH=./data/scorecard.sqlite
