{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "@scorecard/api#dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "GEMINI_API_KEY",
        "OPENAI_API_KEY",
        "JEV_API_KEY",
        "PORT",
        "SCORECARD_DB_PATH"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "CI",
    "NODE_ENV"
  ]
}
