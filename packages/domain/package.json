{
  "name": "@scorecard/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared contracts and pure scoring logic for the API and the web app.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  },
  "sideEffects": false
}
